# ITSM secrets - TEMPLATE ONLY.
# Copy to .env and fill in real values. .env is git-ignored: never commit it.
# These placeholders ("changeme...") are safe to share; real values are not.

# MariaDB application database
MYSQL_DATABASE=osticket
MYSQL_USER=osticket
DB_PASSWORD=changeme-app-db-password
DB_ROOT_PASSWORD=changeme-root-db-password

# osTicket installer admin account (created during web install)
# Only used once, interactively - kept here so the values live in ONE place.
OSTICKET_ADMIN_EMAIL=admin@example.local
OSTICKET_ADMIN_PASSWORD=changeme-admin-password

# Outgoing mail (optional; needed for ticket notifications)
# SMTP_HOST=smtp.example.local
# SMTP_PORT=587
# SMTP_USER=tickets@example.local
# SMTP_PASSWORD=changeme-smtp-password
